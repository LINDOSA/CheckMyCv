# CheckMyCV Production Environment Variables Template
# Copy this file to .env.local and populate with your credentials.

# ---------------------------------------------------------------------------
# LLM Diagnostic & Parsing Providers (at least one is required)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Paystack — the payment rail (South Africa, ZAR)
# ---------------------------------------------------------------------------
# Dashboard > Settings > API Keys & Webhooks. Use sk_test_... until you go live.
# This ONE key does two jobs: authorising API calls AND verifying webhook
# signatures. Paystack has no separate webhook secret.
PAYSTACK_SECRET_KEY="sk_test_..."

# Price of the Executive Rewrite pass, in ZAR cents. 16000 = R160.00.
# Change this to change the price; no code edit needed.
PAYSTACK_AMOUNT_CENTS="16000"

# Register the webhook at Dashboard > Settings > API Keys & Webhooks:
#   https://YOUR_DOMAIN/api/paystack/webhook
# Paystack only sends webhooks to a public URL, so to test locally, expose
# your dev server first (e.g. `ngrok http 3000`) and register that URL.

# ---------------------------------------------------------------------------
# Payment registry storage
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Without it the registry falls back to a JSON file,
# which is wiped on every deploy on Vercel and other serverless hosts — paying
# customers would lose access and the invoice trail would be lost.
# Any Postgres connection string works (Supabase, Neon, Railway, RDS).
# On Supabase use the CONNECTION POOLER url (port 6543), not the direct one.
# The table is created automatically on first use.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Public Site URL — used for Paystack callback redirects, sitemap and robots
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.checkmycv.co.za"

# ---------------------------------------------------------------------------
# Legacy Stripe routes (/api/stripe/*)
# ---------------------------------------------------------------------------
# Kept for a future international rollout. Leave blank to keep them disabled;
# with no key they return 503 and unlock nothing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Developer-only shortcut that fakes a paid Stripe session.
# MUST stay "false" (or unset) anywhere real money is involved.
ENABLE_PAYMENT_TEST_BYPASS="false"
